# Where the data lives.
#
# Development is SQLite, which needs no server:
#   DATABASE_URL="file:./prisma/dev.db"
#
# Production (and any shared environment) is Postgres. Note `sslmode=verify-full`
# rather than the more familiar `require`: pg-connection-string treats `require`,
# `prefer` and `verify-ca` as aliases for `verify-full` and prints a deprecation
# warning on every connection, so writing it out says the same thing without the
# noise. Managed providers hand you the string with `sslmode=require` in it —
# changing that one word is all this takes.
#
#   DATABASE_URL="postgres://user:password@host:5432/database?sslmode=verify-full"
DATABASE_URL="file:./prisma/dev.db"

# Secret used by Auth.js to sign and encrypt tokens. Generate one with:
#   npx auth secret
AUTH_SECRET="replace-me"

# Set to "true" whenever the app sits behind a reverse proxy or a load balancer,
# so Auth.js takes the origin from the Host / x-forwarded-host header instead of
# guessing it. Harmless locally; the redirect after sign-in needs it in production.
AUTH_TRUST_HOST="true"

# Optional: Google OAuth credentials for Auth.js.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Stripe payment processing (optional for development).
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Order confirmation email (optional). Without RESEND_API_KEY, receipts are
# logged to the dev server console instead of being sent.
# RESEND_API_KEY=""
# EMAIL_FROM="Verdant Nursery <orders@verdant.dev>"

# Application URL (used for OAuth callbacks, email links and Stripe redirects).
# APP_URL="http://localhost:3000"
