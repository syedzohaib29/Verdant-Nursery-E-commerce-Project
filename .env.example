# Local SQLite database file. Copy this file to `.env` for local development.
DATABASE_URL="file:./prisma/dev.db"

# Secret used by Auth.js to sign and encrypt tokens. Generate one with:
#   npx auth secret
AUTH_SECRET="replace-me"

# Set to "true" whenever the app sits behind a reverse proxy or a load balancer,
# so Auth.js takes the origin from the Host / x-forwarded-host header instead of
# guessing it. Harmless locally; the redirect after sign-in needs it in production.
AUTH_TRUST_HOST="true"

# Optional: Google OAuth credentials for Auth.js.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Stripe payment processing (optional for development).
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Application URL (used for OAuth callbacks and email links).
# APP_URL="http://localhost:3000"
